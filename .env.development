# Só no `vite`/`tauri dev` (modo development). `bun run build`/`tauri build`
# ignoram este arquivo e usam o `.env`.
#
# O app fala com o próprio Vite e ele repassa pros alvos abaixo (ver
# `vite.config.ts`): o CORS do API Gateway de prod não libera localhost:1420.
VITE_SEPARACAO_API_URL=http://localhost:1420/api
VITE_SEPARACAO_WS_URL=ws://localhost:1420/ws

# Alvos do proxy. Pra rodar contra o nexus local, troque pra
# http://localhost:3010/api e ws://localhost:3011 (ou o que o nexus subir).
DEV_PROXY_API_TARGET=https://api-nexus.cloud.berzerk.com.br/api
DEV_PROXY_WS_TARGET=wss://vo0909i95e.execute-api.us-east-1.amazonaws.com/prod
