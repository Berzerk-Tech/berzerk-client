VITE_SUPABASE_URL=https://hvnysnfmsndjehjndipc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# API de separação/expedição (nexus). A base PRECISA terminar em /api (setGlobalPrefix global do NestJS).
# Prod: https://api-nexus.cloud.berzerk.com.br/api  |  Local: http://localhost:3010/api
VITE_SEPARACAO_API_URL=https://api-nexus.cloud.berzerk.com.br/api

# Autenticação da Separação/Expedição: a MESMA sessão Google (Supabase) do app — não há
# segundo login. O nexus valida o token (bridge HS256) e resolve as permissões
# pelo RBAC dele (papel com `separacao:operate` / `expedicao:operate`, casado por email).

# Roda a Separação em paralelo ao pós-venda antes do cutover (opcional).
# VITE_SEPARACAO_SHADOW=true

# WebSocket do nexus: push de queue.changed (o polling de 60s vira fallback).
# Prod: wss://<ws-api-id>.execute-api.us-east-1.amazonaws.com/prod (output ws_api_endpoint da stack nexus/prod, trocando https por wss)
VITE_SEPARACAO_WS_URL=

# ── Expedição ────────────────────────────────────────────────────────────────
# Estes dois são só VALORES PADRÃO iniciais — o controle de verdade é no app, em
# Configurações → Expedição (toggles "Modo teste" e "Simulação"), salvo por
# estação. Normalmente não precisa mexer aqui.
#
# Modo padrão na primeira vez: "teste" (default, não expede nada) ou "oficial".
# VITE_EXPEDICAO_MODO=teste
# Simulação (pedidos fictícios, sem servidor) ligada por padrão:
# VITE_EXPEDICAO_MOCK=false
