# ── Login (Cognito do Nexus) ─────────────────────────────────────────────────
# O app entra pelo Nexus: Authorization Code + PKCE no Hosted UI, Google
# @berzerk.com.br, callback no loopback http://127.0.0.1:54321/oauth-callback.
# Nada aqui é segredo (app client nativo, sem client secret).
#
# PROD:
VITE_COGNITO_DOMAIN=https://auth.cloud.berzerk.com.br
VITE_COGNITO_CLIENT_ID=3fblnt9gohl76eflpphff13okc
VITE_COGNITO_REGION=us-east-1
#
# DEV (stack nexus/dev — usar junto com a API dev):
# VITE_COGNITO_DOMAIN=https://auth.dev.cloud.berzerk.com.br
# VITE_COGNITO_CLIENT_ID=ugc706cc2h2ju752najt904g8
#
# Os client ids saem de `terraform output cognito_desktop_client_id` na stack
# `nexus/<env>` do berzerk-infra.

# ── API do Nexus ─────────────────────────────────────────────────────────────
# Separação, Expedição e o handoff da sessão Supabase. A base PRECISA terminar
# em /api (setGlobalPrefix global do NestJS).
# Prod: https://api-nexus.cloud.berzerk.com.br/api  |  Local: http://localhost:3010/api
VITE_SEPARACAO_API_URL=https://api-nexus.cloud.berzerk.com.br/api

# Roda a Separação em paralelo ao pós-venda antes do cutover (opcional).
# VITE_SEPARACAO_SHADOW=true

# WebSocket do nexus: push de queue.changed (o polling de 60s vira fallback).
# Prod: wss://<ws-api-id>.execute-api.us-east-1.amazonaws.com/prod (output ws_api_endpoint da stack nexus/prod, trocando https por wss)
VITE_SEPARACAO_WS_URL=

# ── Supabase (só a Etiquetagem/Rastreio, até a fase 3 do corte) ───────────────
# NÃO é mais login: a sessão Supabase é DERIVADA da sessão do Nexus
# (POST /desktop/handoff → verifyOtp, ver src/lib/supabase-derivada.ts).
# Se o handoff falhar, o app segue logado e só a Etiquetagem fica indisponível.
VITE_SUPABASE_URL=https://hvnysnfmsndjehjndipc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Expedição ────────────────────────────────────────────────────────────────
# Estes dois são só VALORES PADRÃO iniciais — o controle de verdade é no app, em
# Configurações → Expedição (toggles "Modo teste" e "Simulação"), salvo por
# estação. Normalmente não precisa mexer aqui.
#
# Modo padrão na primeira vez: "teste" (default, não expede nada) ou "oficial".
# VITE_EXPEDICAO_MODO=teste
# Simulação (pedidos fictícios, sem servidor) ligada por padrão:
# VITE_EXPEDICAO_MOCK=false
