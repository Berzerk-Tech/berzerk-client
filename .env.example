VITE_SUPABASE_URL=https://hvnysnfmsndjehjndipc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# API de separação (nexus). A base PRECISA terminar em /api (setGlobalPrefix global do NestJS).
# Prod: https://api-nexus.cloud.berzerk.com.br/api  |  Local: http://localhost:3010/api
VITE_SEPARACAO_API_URL=https://api-nexus.cloud.berzerk.com.br/api

# Cognito — pool `berzerk-ops-<env>` (operadores de chão de fábrica, USER_PASSWORD_AUTH inline).
# Client id sai do output terraform `ops_user_pool_client_id` da stack stacks/nexus/<env>.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_OPS_CLIENT_ID=

# Roda a Separação em paralelo ao pós-venda antes do cutover (opcional).
# VITE_SEPARACAO_SHADOW=true
